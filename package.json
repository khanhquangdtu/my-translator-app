{
  "name": "my-translator-pwa",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/dev-guard.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node scripts/e2e.mjs",
    "soniox": "node scripts/soniox-check.mjs",
    "caption": "node scripts/caption-check.mjs",
    "predev:lan": "node scripts/dev-guard.mjs && node scripts/lan-url.mjs",
    "dev:lan": "next dev --hostname 0.0.0.0 --experimental-https --experimental-https-key certificates/localhost-key.pem --experimental-https-cert certificates/localhost.pem",
    "start:lan": "node scripts/start-lan.mjs"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "mongodb": "^6.20.0",
    "next": "^15.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.37.0",
    "eslint-config-next": "^15.5.4",
    "mongodb-memory-server": "^11.2.0",
    "puppeteer-core": "^25.8.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

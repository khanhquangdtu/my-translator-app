# Provider keys — server-side only. Unlike the Expo build, these are NEVER
# inlined into the browser bundle: the browser gets a short-lived Soniox
# temporary key from /api/soniox/token, and never touches OpenAI at all.
SONIOX_API_KEY=
OPENAI_API_KEY=

# MongoDB — where saved sessions live.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=my_translator

# Set to 1 to run the scripted mock engine instead of Soniox (no key needed).
NEXT_PUBLIC_MOCK_ENGINE=

# AWS — point the SDK at the project-local profile in .aws/ instead of ~/.aws.
AWS_PROFILE=my-translator-pwa
AWS_CONFIG_FILE=.aws/config
AWS_SHARED_CREDENTIALS_FILE=.aws/credentials

# ─── Admin area ────────────────────────────────────────────────────────
# Both must be set before /admin will do anything; without them the page
# renders a "disabled" notice instead of a login form.
#
# ADMIN_PASSWORD is what you type to sign in.
# ADMIN_SECRET signs the session cookie AND encrypts provider keys at rest.
# Generate one with:  openssl rand -base64 32
#
# Changing ADMIN_SECRET invalidates every session and makes stored provider
# keys undecryptable -- the app falls back to the keys above, which is a
# degradation rather than an outage, but the stored ones must be re-entered.
ADMIN_PASSWORD=
ADMIN_SECRET=
